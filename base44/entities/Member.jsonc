{
  "name": "Member",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "occupation": {
      "type": "string"
    },
    "dob": {
      "type": "string",
      "format": "date"
    },
    "motivation": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "membership_type": {
      "type": "string",
      "enum": [
        "general",
        "volunteer",
        "life"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple"
      ],
      "default": "general"
    },
    "membership_no": {
      "type": "string"
    },
    "lookup_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "pending"
    },
    "approved_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "phone"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}