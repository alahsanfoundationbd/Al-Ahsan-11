{
  "name": "Activity",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0995\u09be\u09b0\u09cd\u09af\u0995\u09cd\u09b0\u09ae\u09c7\u09b0 \u09a8\u09be\u09ae"
    },
    "category": {
      "type": "string",
      "description": "\u0996\u09be\u09a6\u09cd\u09af \u09b8\u09b9\u09be\u09af\u09bc\u09a4\u09be, \u09b6\u09bf\u0995\u09cd\u09b7\u09be, \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af \u0987\u09a4\u09cd\u09af\u09be\u09a6\u09bf"
    },
    "location": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "video_url": {
      "type": "string"
    },
    "target_amount": {
      "type": "number",
      "default": 0
    },
    "raised_amount": {
      "type": "number",
      "default": 0
    },
    "donor_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "upcoming"
      ],
      "enumColors": [
        "green",
        "gray",
        "yellow"
      ],
      "default": "active"
    },
    "is_featured": {
      "type": "boolean",
      "default": true
    },
    "is_published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}